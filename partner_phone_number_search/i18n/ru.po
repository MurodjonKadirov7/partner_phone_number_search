#. module: partner_phone_number_search
#: model:ir.module.module,summary:base.module_partner_phone_number_search
msgid ""
"Type a phone number in any customer or contact field and find the partner, "
"whatever the format: spaces, brackets, dashes, +, 00"
msgstr "Введите номер телефона в любом поле клиента или контакта и найдите партнёра в любом формате: пробелы, скобки, дефисы, +, 00"
